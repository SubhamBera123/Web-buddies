# NexusCraft Web Studio - Environment Variables

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://placeholder-project.supabase.co

# Supabase Anon Public API Key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=placeholder-anon-key-abc123xyz789

# Notice: If left as placeholder or empty, NexusCraft runs seamlessly in 
# resilient Local Mock Mode so you can demo, review, and test the full application immediately!
